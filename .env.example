# Copy to .env.local for local development
# Optional local override (defaults to https://app.bookingbroom.com)
# BOOKING_BROOM_URL=http://localhost:3000
BOOKING_BROOM_API_KEY=bb_deltona_dev_key
# BOOKING_BROOM_SITE_SLUG hardcoded to deltona in code — do not set
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback when Booking Broom is down (set as Cloudflare Worker secrets in prod):
# wrangler secret put BOOKING_BROOM_API_KEY
# wrangler secret put TELEGRAM_BOT_TOKEN
# wrangler secret put TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
